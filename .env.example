# Commerce defaults to read-only catalog mode.
COMMERCE_MODE=catalog
COMMERCE_CURRENCY=CNY
COMMERCE_RESERVATION_MINUTES=15

# Required for sandbox/live transaction modes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COMMERCE_SESSION_SECRET=
COMMERCE_INTERNAL_SHARED_SECRET=
COMMERCE_PUBLIC_BASE_URL=
COMMERCE_SHIPPING_RULE_VERSION=
COMMERCE_TERMS_VERSION=
COMMERCE_PRIVACY_VERSION=
COMMERCE_REFUND_POLICY_VERSION=

# WeChat Pay API v3. Both providers can be configured independently.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=

# Alipay Open Platform.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
